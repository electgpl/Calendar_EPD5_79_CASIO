/*===========================================================================
 *  SECCION 1 - CAPA SPI POR SOFTWARE  (ex spi.h / spi.cpp)
 *=========================================================================*/
#define SCK  12
#define MOSI 11
#define RES  47
#define DC   46
#define CS   45
#define BUSY 48

#define EPD_SCK_Clr()  digitalWrite(SCK, LOW)
#define EPD_SCK_Set()  digitalWrite(SCK, HIGH)
#define EPD_MOSI_Clr() digitalWrite(MOSI, LOW)
#define EPD_MOSI_Set() digitalWrite(MOSI, HIGH)
#define EPD_RES_Clr()  digitalWrite(RES, LOW)
#define EPD_RES_Set()  digitalWrite(RES, HIGH)
#define EPD_DC_Clr()   digitalWrite(DC, LOW)
#define EPD_DC_Set()   digitalWrite(DC, HIGH)
#define EPD_CS_Clr()   digitalWrite(CS, LOW)
#define EPD_CS_Set()   digitalWrite(CS, HIGH)
#define EPD_ReadBUSY   digitalRead(BUSY)

void EPD_GPIOInit(void) {
  pinMode(SCK, OUTPUT);
  pinMode(MOSI, OUTPUT);
  pinMode(RES, OUTPUT);
  pinMode(DC, OUTPUT);
  pinMode(CS, OUTPUT);
  pinMode(BUSY, INPUT);
}

// SPI por bit-banging: un byte, MSB primero
void EPD_WR_Bus(uint8_t dat) {
  EPD_CS_Clr();
  for (uint8_t i = 0; i < 8; i++) {
    EPD_SCK_Clr();
    if (dat & 0x80) EPD_MOSI_Set();
    else            EPD_MOSI_Clr();
    EPD_SCK_Set();
    dat <<= 1;
  }
  EPD_CS_Set();
}

void EPD_WR_REG(uint8_t reg) {
  EPD_DC_Clr();
  EPD_WR_Bus(reg);
  EPD_DC_Set();
}

void EPD_WR_DATA8(uint8_t dat) {
  EPD_DC_Set();
  EPD_WR_Bus(dat);
  EPD_DC_Set();
}

/*===========================================================================
 *  SECCION 2 - DEFINICIONES DEL PANEL  (ex EPD_Init.h)
 *
 *  El panel de 5.79" lleva DOS controladores SSD1683 en cascada. Cada uno
 *  maneja 396x272, pero se direccionan como 400x300, por lo que en la union
 *  de ambos quedan 8 columnas muertas. Por eso el buffer se define como
 *  800x272 aunque el area visible real sea 792x272, y Paint_SetPixel()
 *  aplica un desplazamiento de 8 px para Xpoint >= 396.
 *=========================================================================*/
#define EPD_W 800
#define EPD_H 272

#define WHITE 0xFF
#define BLACK 0x00

#define Source_BYTES    (400/8)
#define Gate_BITS       272
#define ALLSCREEN_BYTES (Source_BYTES*Gate_BITS)

// Orientacion del panel: 0 / 90 / 180 / 270
#define Rotation 180

typedef struct {
  uint8_t *Image;
  uint16_t width;
  uint16_t height;
  uint16_t widthMemory;
  uint16_t heightMemory;
  uint16_t color;
  uint16_t rotate;
  uint16_t widthByte;
  uint16_t heightByte;
} PAINT;

PAINT Paint;

